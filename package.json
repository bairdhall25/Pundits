{
  "name": "pundits",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm test && npm run build && npm run verify:static",
    "deploy": "npm run check && wrangler pages deploy out --project-name pundits"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "4.127.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
