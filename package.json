{
  "name": "pundits",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "og": "tsx scripts/render-og.tsx --force",
    "predev": "tsx scripts/render-og.tsx && tsx scripts/build-social-index.ts",
    "build": "tsx scripts/render-og.tsx && tsx scripts/build-social-index.ts && next build",
    "social:index": "tsx scripts/build-social-index.ts",
    "start": "next start",
    "test": "vitest run",
    "test:ui": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "scout:feeds": "node scripts/scout-feeds.mjs",
    "tips:pull": "tsx scripts/tip-mailbox.mjs pull",
    "tips:add": "tsx scripts/tip-mailbox.mjs add",
    "roster:add": "node scripts/roster-add.mjs",
    "validate:runs": "node scripts/validate-run.mjs docs/runs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:deployed": "node scripts/verify-live.mjs --expected-out",
    "verify:production-urls": "node scripts/verify-production-permalinks.mjs",
    "deploy:guard": "node scripts/deploy-guard.mjs",
    "check": "npm test && npm run validate:runs && npm run build && npm run verify:static",
    "deploy": "npm run deploy:guard && npm run check && npm run deploy:guard && npm run verify:production-urls && node scripts/indexnow.mjs --prepare && npm run deploy:guard && wrangler pages deploy out --project-name pundits --branch main && npm run verify:deployed && node scripts/indexnow.mjs",
    "email:dump": "wrangler kv key list --namespace-id cda9bfd1f31f441297a3082a8875363b --remote",
    "notify:deploy": "wrangler deploy -c workers/email-notify/wrangler.toml"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10",
    "postcss": "^8",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "storybook": "^10.6.0",
    "tailwindcss": "^3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "4.127.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
