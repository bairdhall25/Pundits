{
  "name": "pundits",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "og": "tsx scripts/render-og.tsx --force",
    "predev": "tsx scripts/render-og.tsx",
    "build": "tsx scripts/render-og.tsx --force && next build",
    "start": "next start",
    "test": "vitest run",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm test && npm run build && npm run verify:static",
    "deploy": "npm run check && wrangler pages deploy out --project-name pundits",
    "email:dump": "wrangler kv key list --namespace-id cda9bfd1f31f441297a3082a8875363b --remote",
    "notify:deploy": "wrangler deploy -c workers/email-notify/wrangler.toml"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10",
    "postcss": "^8",
    "satori": "^0.33.4",
    "tailwindcss": "^3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "4.127.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
